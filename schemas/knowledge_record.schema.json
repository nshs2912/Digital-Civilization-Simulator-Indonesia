{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Historical Knowledge Record",
  "type":"object",
  "required":["record_id","claim_id","time_context","evidence","sources","provenance"],
  "properties":{
    "record_id":{"type":"string","minLength":1},
    "claim_id":{"type":"string","minLength":1},
    "time_context":{"$ref":"time_context.schema.json"},
    "spatial_context":{"anyOf":[{"$ref":"spatial_context.schema.json"},{"type":"null"}]},
    "evidence":{"type":"array"},
    "sources":{"type":"array"},
    "provenance":{"type":"array"},
    "metadata":{"type":"object"}
  },
  "additionalProperties":false
}